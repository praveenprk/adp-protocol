{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp-protocol.dev/schema/dispatch.schema.json",
  "title": "ADP Dispatch Envelope",
  "description": "Structured instruction from orchestrator to agent per ADP-1",
  "type": "object",
  "required": ["adp_version", "dispatch", "context", "exit", "report"],
  "properties": {
    "adp_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])",
      "description": "ADP-1 protocol version: SemVer 2.0.0 with major version 1 (ADP-1 §9; V-01, V-11, R-01, R-09)",
      "$comment": "Ends with (?![\\s\\S]), not $: in Python re, $ also matches before a final newline. [0-9], not \\d: in Python re, \\d matches non-ASCII digits."
    },
    "dispatch": {
      "type": "object",
      "required": ["agent", "anchor"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Agent identifier"
        },
        "anchor": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Traceable governing references"
        },
        "model": {
          "type": "string",
          "description": "Model identifier"
        },
        "tier": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "Compression tier indexed to judgment density"
        },
        "gate": {
          "type": "string",
          "description": "Gate identifier"
        },
        "branch": {
          "type": "string",
          "description": "Version control branch"
        }
      }
    },
    "context": {
      "type": "object",
      "required": ["read"],
      "properties": {
        "read": {
          "type": "array",
          "items": { "$ref": "#/$defs/ReadEntry" },
          "minItems": 1,
          "description": "Required context consumed before work"
        },
        "ignore": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Isolation boundary patterns"
        }
      }
    },
    "produce": {
      "type": "array",
      "items": { "$ref": "#/$defs/ProduceEntry" },
      "description": "Output artifacts"
    },
    "work_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/WorkItem" },
      "description": "Directive-bearing work items"
    },
    "exit": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Binary pass/fail completion conditions"
    },
    "report": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "description": "Structured handoff items"
    },
    "metadata": { "$ref": "#/$defs/Metadata" }
  },
  "anyOf": [
    { "required": ["produce"] },
    { "required": ["work_items"] }
  ],
  "if": { "properties": { "adp_version": { "pattern": "^1\\.[01]\\." } } },
  "then": { "$ref": "#/$defs/Closed" },
  "$defs": {
    "ReadEntry": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "File or resource path"
        },
        "sections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Section-level references"
        }
      }
    },
    "ProduceEntry": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Output artifact path"
        },
        "action": {
          "type": "string",
          "enum": ["create", "modify"],
          "description": "Create new or modify existing"
        }
      }
    },
    "WorkItem": {
      "type": "object",
      "required": ["keyword", "description"],
      "properties": {
        "keyword": {
          "type": "string",
          "enum": [
            "PRODUCE",
            "BIND",
            "CONFIRM",
            "SURFACE",
            "DEFER",
            "READ",
            "IGNORE",
            "REPORT",
            "EXIT",
            "ANCHOR"
          ],
          "description": "ADP keyword directive"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Directive content"
        },
        "source": {
          "type": "string",
          "description": "Origin reference in governing document"
        },
        "metadata": { "$ref": "#/$defs/Metadata" }
      }
    },
    "Metadata": {
      "type": "object",
      "propertyNames": { "pattern": "^x-[a-z]+-[a-z0-9-]+$" },
      "description": "Namespaced extensions (ADP-1 §3.5; V-12, R-11)"
    },
    "Closed": {
      "$comment": "V-09: unknown fields are rejected when the minor version is one this schema implements (ADP-1 §7.3). Update the if-pattern above when a minor version is added.",
      "propertyNames": { "enum": ["adp_version", "dispatch", "context", "produce", "work_items", "exit", "report", "metadata"] },
      "properties": {
        "dispatch": { "propertyNames": { "enum": ["agent", "anchor", "model", "tier", "gate", "branch"] } },
        "context": {
          "propertyNames": { "enum": ["read", "ignore"] },
          "properties": { "read": { "items": { "propertyNames": { "enum": ["path", "sections"] } } } }
        },
        "produce": { "items": { "propertyNames": { "enum": ["path", "action"] } } },
        "work_items": { "items": { "propertyNames": { "enum": ["keyword", "description", "source", "metadata"] } } }
      }
    }
  }
}
