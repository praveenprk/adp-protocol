{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adp-protocol.dev/schema/report.schema.json",
  "title": "ADP Report Envelope",
  "description": "Structured result from agent to orchestrator per ADP-1",
  "type": "object",
  "required": ["adp_version", "report", "exit_results", "items"],
  "properties": {
    "adp_version": {
      "type": "string",
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(?![\\s\\S])",
      "description": "ADP-1 protocol version: SemVer 2.0.0 with major version 1 (ADP-1 §9; V-01, V-11, R-01, R-09)",
      "$comment": "Ends with (?![\\s\\S]), not $: in Python re, $ also matches before a final newline. [0-9], not \\d: in Python re, \\d matches non-ASCII digits."
    },
    "report": {
      "type": "object",
      "required": ["agent", "anchor", "status"],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1,
          "description": "Agent identifier"
        },
        "anchor": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Traceable governing references"
        },
        "status": {
          "type": "string",
          "enum": ["COMPLETE", "BLOCKED", "SURFACE"],
          "description": "Dispatch outcome"
        }
      }
    },
    "exit_results": {
      "type": "array",
      "items": { "$ref": "#/$defs/ExitResult" },
      "minItems": 1,
      "description": "Pass/fail for each EXIT condition"
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/ReportItem" },
      "minItems": 1,
      "description": "Structured handoff items"
    },
    "metadata": { "$ref": "#/$defs/Metadata" }
  },
  "if": { "properties": { "adp_version": { "pattern": "^1\\.[01]\\." } } },
  "then": { "$ref": "#/$defs/Closed" },
  "allOf": [
    {
      "if": {
        "properties": {
          "report": {
            "properties": { "status": { "const": "BLOCKED" } }
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "contains": {
              "properties": { "key": { "const": "blocker" } },
              "required": ["key"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "report": {
            "properties": { "status": { "const": "SURFACE" } }
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "contains": {
              "properties": { "key": { "const": "finding" } },
              "required": ["key"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ExitResult": {
      "type": "object",
      "required": ["condition", "result"],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "Echoes the EXIT condition from dispatch"
        },
        "result": {
          "type": "boolean",
          "description": "Pass or fail"
        }
      }
    },
    "ReportItem": {
      "type": "object",
      "required": ["key", "value"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      }
    },
    "Metadata": {
      "type": "object",
      "propertyNames": { "pattern": "^x-[a-z]+-[a-z0-9-]+$" },
      "description": "Namespaced extensions (ADP-1 §3.5; V-12, R-11)"
    },
    "Closed": {
      "$comment": "R-10: unknown fields are rejected when the minor version is one this schema implements (ADP-1 §7.3). Update the if-pattern above when a minor version is added.",
      "propertyNames": { "enum": ["adp_version", "report", "exit_results", "items", "metadata"] },
      "properties": {
        "report": { "propertyNames": { "enum": ["agent", "anchor", "status"] } },
        "exit_results": { "items": { "propertyNames": { "enum": ["condition", "result"] } } },
        "items": { "items": { "propertyNames": { "enum": ["key", "value"] } } }
      }
    }
  }
}
